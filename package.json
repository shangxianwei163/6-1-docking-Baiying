{
  "name": "outbound-console-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "outbound-contracts",
    "outbound-platform-api"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run build --workspace @outbound/contracts",
    "dev": "vinext dev",
    "prebuild": "npm run build --workspace @outbound/contracts",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "backend:build": "npm run build --workspace @outbound/contracts && npm run build --workspace @outbound/platform-api",
    "backend:dev": "npm run dev --workspace @outbound/platform-api",
    "backend:test": "npm run test --workspace @outbound/platform-api",
    "backend:typecheck": "npm run typecheck --workspace @outbound/contracts && npm run typecheck --workspace @outbound/platform-api",
    "db:up": "docker compose --env-file .env.postgres.local up -d postgres",
    "db:down": "docker compose --env-file .env.postgres.local down",
    "db:logs": "docker compose --env-file .env.postgres.local logs -f postgres",
    "db:migrate": "npm run db:migrate --workspace @outbound/platform-api",
    "db:seed": "npm run db:seed --workspace @outbound/platform-api",
    "db:import:phase1": "npm run db:import:phase1 --workspace @outbound/platform-api",
    "db:reconcile:phase1": "npm run db:reconcile:phase1 --workspace @outbound/platform-api",
    "db:verify:phase1": "npm run db:verify:phase1 --workspace @outbound/platform-api",
    "db:bootstrap:stage2-local": "npm run db:bootstrap:stage2-local --workspace @outbound/platform-api",
    "db:verify:stage2": "npm run db:verify:stage2 --workspace @outbound/platform-api",
    "db:verify:stage3": "npm run db:verify:stage3 --workspace @outbound/platform-api",
    "db:verify:stage4": "npm run db:verify:stage4 --workspace @outbound/platform-api",
    "db:verify:stage5a": "npm run db:verify:stage5a --workspace @outbound/platform-api",
    "db:verify:stage5b": "npm run db:verify:stage5b --workspace @outbound/platform-api",
    "db:verify:stage6b": "npm run db:verify:stage6b --workspace @outbound/platform-api",
    "db:verify:stage6b2": "npm run db:verify:stage6b2 --workspace @outbound/platform-api",
    "db:verify:stage6b3": "npm run db:verify:stage6b3 --workspace @outbound/platform-api",
    "db:verify:stage6b3b": "npm run db:verify:stage6b3b --workspace @outbound/platform-api",
    "db:verify:stage7a": "npm run db:verify:stage7a --workspace @outbound/platform-api",
    "db:verify:stage7b": "npm run db:verify:stage7b --workspace @outbound/platform-api",
    "stage2:send:erp": "npm run stage2:send:erp --workspace @outbound/platform-api",
    "stage2:send:crm": "npm run stage2:send:crm --workspace @outbound/platform-api",
    "stage3:worker:local": "npm run stage3:worker:local --workspace @outbound/platform-api",
    "stage4:worker:local": "npm run stage4:worker:local --workspace @outbound/platform-api",
    "stage5:worker:local": "npm run stage5:worker:local --workspace @outbound/platform-api",
    "stage5b:worker:local": "npm run stage5b:worker:local --workspace @outbound/platform-api",
    "stage6:verify:ui": "python3 scripts/verify-stage6-ui.py",
    "stage6b:verify:ui": "python3 scripts/verify-stage6b-ui.py",
    "stage6b2:verify:ui": "python3 scripts/verify-stage6b2-ui.py",
    "stage6b3:verify:ui": "python3 scripts/verify-stage6b3-ui.py",
    "stage6b3b:verify:ui": "python3 scripts/verify-stage6b3b-ui.py",
    "stage6b3c:verify:api": "npm run test --workspace @outbound/platform-api -- --run src/operations/callback-preview-service.test.ts src/http/callback-preview.test.ts",
    "stage6b3c:verify:source": "node scripts/verify-stage6b3c-source.mjs",
    "stage6b3c:verify:ui": "python3 scripts/verify-stage6b3c-ui.py",
    "stage6b3c:verify": "npm run stage6b3c:verify:source && npm run stage6b3c:verify:api && npm run stage6b3c:verify:ui",
    "stage7b:verify:ui": "python3 scripts/verify-stage7b-ui.py",
    "stage7:verify:local": "node scripts/verify-stage7-local.mjs",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@outbound/contracts": "0.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
