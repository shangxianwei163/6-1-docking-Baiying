{
  "name": "@outbound/platform-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "predev": "npm run build --workspace @outbound/contracts",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build --workspace @outbound/contracts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretypecheck": "npm run build --workspace @outbound/contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build --workspace @outbound/contracts",
    "test": "vitest run --config vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:import:phase1": "tsx src/db/import-phase1-static-config.ts",
    "db:reconcile:phase1": "tsx src/db/reconcile-phase1.ts",
    "db:verify:phase1": "tsx src/db/verify-phase1.ts",
    "db:bootstrap:stage2-local": "tsx src/db/bootstrap-stage2-local.ts",
    "db:verify:stage2": "tsx src/db/verify-stage2.ts",
    "db:verify:stage3": "tsx src/db/verify-stage3.ts",
    "db:verify:stage4": "tsx src/db/verify-stage4.ts",
    "db:verify:stage4b": "tsx src/db/verify-stage4.ts",
    "db:verify:stage5a": "tsx src/db/verify-stage5a.ts",
    "db:verify:stage5b": "tsx src/db/verify-stage5b.ts",
    "db:verify:stage6b": "tsx src/db/verify-stage6b.ts",
    "db:verify:stage6b2": "tsx src/db/verify-stage6b2.ts",
    "db:verify:stage6b3": "tsx src/db/verify-stage6b3.ts",
    "db:verify:stage6b3b": "tsx src/db/verify-stage6b3b.ts",
    "db:verify:stage7a": "tsx src/db/verify-stage7a.ts",
    "db:verify:stage7b": "tsx src/db/verify-stage7b.ts",
    "stage2:send:erp": "tsx src/openapi/send-local-example.ts ERP",
    "stage2:send:crm": "tsx src/openapi/send-local-example.ts CRM",
    "stage3:worker:local": "tsx src/orchestration/local-worker.ts",
    "stage4:worker:local": "tsx src/callback/local-worker.ts",
    "stage4b:worker": "tsx src/reconciliation/local-worker.ts",
    "stage5:worker:local": "tsx src/recording/local-worker.ts",
    "recording:network-worker": "tsx src/recording/network-worker.ts",
    "recording:verify-oss": "tsx src/recording/verify-oss-access.ts",
    "recording:migrate-oss": "tsx src/recording/migrate-local-to-oss.ts",
    "stage5b:worker:local": "tsx src/delivery/local-worker.ts",
    "callback:delivery-worker": "tsx src/delivery/network-worker.ts",
    "preseed": "npm run build --workspace @outbound/contracts",
    "db:seed": "tsx src/db/seed.ts",
    "baiying:check": "tsx src/baiying/check-connection.ts",
    "baiying:sync": "tsx src/baiying/sync-to-postgres.ts",
    "baiying:worker": "tsx watch src/baiying/local-sync-worker.ts",
    "baiying:task-worker": "tsx src/orchestration/baiying-worker.ts",
    "baiying:verify:live": "tsx src/baiying/verify-live-lifecycle.ts"
  },
  "dependencies": {
    "@alicloud/credentials": "^2.4.7",
    "@hono/node-server": "2.1.1",
    "@outbound/contracts": "0.1.0",
    "ali-oss": "^6.23.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "postgres": "3.4.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/node": "22.19.19",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
