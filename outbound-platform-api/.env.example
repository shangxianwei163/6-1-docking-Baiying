NODE_ENV=development
PORT=8788
DATABASE_URL=postgres://outbound:outbound@127.0.0.1:5432/outbound
CONSOLE_ORIGIN=http://localhost:4173

# 百应密钥只允许注入后端 Secret；Token 有效期为 7 天，由后端缓存和续取。
BAIYING_BASE_URL=https://open.byai.com
BAIYING_TOKEN_URL=https://open-tcs.byai.com/oauth/token
BAIYING_COMPANY_ID=
BAIYING_APP_KEY=
BAIYING_APP_SECRET=

# 素玄 ERP 数据分类接口。Token 由 ERP 提供，只允许注入后端环境变量。
SX_ERP_CATEGORY_URL=http://testmc.6161520.cn:8083/SAi/Sx_AllCategoryLevel
SX_ERP_CATEGORY_TOKEN=
SX_ERP_CATEGORY_SYNC_INTERVAL_MS=21600000

# 首期由 PostgreSQL Outbox Worker 使用；达到扩容阈值后接阿里云 RocketMQ。
VARIABLE_SYNC_QUEUE_NAME=variable-sync-queue
TASK_ORCHESTRATION_QUEUE_NAME=task-orchestration-queue
CALLBACK_DELIVERY_QUEUE_NAME=callback-delivery-queue
# 仅供 stage3:worker:local 故障注入；生产环境禁止使用本地模拟 Worker。
LOCAL_BAIYING_SCENARIO=SUCCESS

# 仅供 Stage 5A 本地零网络录音归档；生产环境必须改用 OSS/KMS 适配器。
RECORDING_LOCAL_ROOT=.local-recordings
RECORDING_LOCAL_BUCKET=local-recordings
RECORDING_PUBLIC_BASE_URL=http://127.0.0.1:8788
# 本地投递事件必须保留 HTTPS 语义；该 .invalid 地址不会发生网络访问。
RECORDING_CALLBACK_BASE_URL=https://recordings.mock.invalid
RECORDING_DOWNLOAD_TTL_SECONDS=900
RECORDING_MAX_BYTES=104857600
RECORDING_RETENTION_DAYS=180
# 仅供 stage5b:worker:local 故障注入：SUCCESS / RETRY_ONCE / PERMANENT_FAILURE。
LOCAL_DELIVERY_SCENARIO=SUCCESS
WORKER_SHARED_SECRET=replace-with-a-long-random-secret
