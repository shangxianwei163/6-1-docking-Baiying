NODE_ENV=development
PORT=8788
DATABASE_URL=postgres://outbound:outbound@127.0.0.1:5432/outbound
CONSOLE_ORIGIN=http://localhost:4173

# 百应密钥只允许注入后端 Secret；Token 有效期为 7 天，由后端缓存和续取。
BAIYING_BASE_URL=https://open.byai.com
BAIYING_TOKEN_URL=https://open-tcs.byai.com/oauth/token
BAIYING_COMPANY_ID=
BAIYING_APP_KEY=
BAIYING_APP_SECRET=

# Cloudflare Queue 生产者配置，由部署环境注入。
VARIABLE_SYNC_QUEUE_NAME=variable-sync-queue
WORKER_SHARED_SECRET=replace-with-a-long-random-secret
